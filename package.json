{
  "name": "motionstudio",
  "version": "0.6.0",
  "private": true,
  "description": "MotionStudio core — renderer, tests, docs and quality gates (static site root: app/). The Electron desktop shell lives in the motionstudio-desktop repository.",
  "license": "MIT",
  "author": "Satyr_Astry",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Satyr-Astry/motionstudio.git"
  },
  "homepage": "https://github.com/Satyr-Astry/motionstudio#readme",
  "bugs": {
    "url": "https://github.com/Satyr-Astry/motionstudio/issues"
  },
  "keywords": [
    "animation",
    "2d",
    "timeline",
    "keyframe",
    "electron",
    "texture",
    "psd"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node _check-static.mjs && node _check-syntax.mjs && node _check-layers.mjs && node _check-docs.mjs && node _check-i18n.mjs",
    "check:static": "node _check-static.mjs",
    "check:syntax": "node _check-syntax.mjs",
    "check:layers": "node _check-layers.mjs",
    "check:docs": "node _check-docs.mjs",
    "check:i18n": "node _check-i18n.mjs",
    "check:i18n:strict": "node _check-i18n.mjs --strict",
    "smoke": "set ELECTRON_RUN_AS_NODE=&& electron tools-smoke.cjs",
    "serve": "node tools-serve.mjs"
  },
  "devDependencies": {
    "electron": "^40.10.2"
  }
}
