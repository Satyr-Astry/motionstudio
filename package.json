{
  "name": "motionstudio",
  "version": "0.1.2-alpha.9",
  "private": true,
  "description": "MotionStudio —— 时间驱动的 2D 动画编辑器（Alpha 预览版）",
  "main": "main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "check": "node _check-static.mjs && node _check-syntax.mjs",
    "check:static": "node _check-static.mjs",
    "check:syntax": "node _check-syntax.mjs",
    "dist": "electron-builder --win nsis --publish never",
    "dist:dir": "electron-builder --win dir --publish never"
  },
  "devDependencies": {
    "electron": "^40.10.2",
    "electron-builder": "^26.18.0"
  },
  "author": "Satyr_Astry",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Satyr-Astry/motionstudio.git"
  },
  "homepage": "https://github.com/Satyr-Astry/motionstudio#readme",
  "bugs": {
    "url": "https://github.com/Satyr-Astry/motionstudio/issues"
  },
  "keywords": [
    "animation",
    "2d",
    "timeline",
    "keyframe",
    "electron",
    "texture",
    "psd"
  ],
  "build": {
    "appId": "com.satyr.motionstudio",
    "productName": "MotionStudio",
    "copyright": "Copyright © 2026 Satyr_Astry",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "app/**/*",
      "!app/promo/img/**",
      "!**/*.map"
    ],
    "extraMetadata": {
      "main": "main.js"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "MotionStudio-${version}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MotionStudio",
      "deleteAppDataOnUninstall": false
    }
  }
}
